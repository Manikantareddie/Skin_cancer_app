# DermaAssist Backend Environment Configuration Example
# Copy this file to .env or configure in Render Dashboard environment variables

# NVIDIA API Configuration for Clinical AI Explanations
# Get your API key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# CORS Allowed Origins
# Comma-separated or JSON list of frontend URLs.
# Note: Vercel domains (*.vercel.app) are automatically permitted via ALLOWED_ORIGIN_REGEX.
ALLOWED_ORIGINS=https://skin-cancer-app-three.vercel.app,http://localhost:5173,http://localhost:3000

# Server Listening Port (Render assigns this automatically via $PORT)
PORT=8000

# Local Model Directory
MODEL_DIR=data/models
